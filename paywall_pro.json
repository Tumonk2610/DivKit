                            },
                            {
                              "position": "@{max(0.0, min(1.0, shine + 0.05))}",
                              "color": "#3DFFFFFF"
                            },
                            {
                              "position": "@{max(0.0, min(1.0, shine + 0.16))}",
                              "color": "#00FFFFFF"
